# Copy this file to .env for local development and replace the values.
# Never commit your real .env file or production secrets.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=development
# Local SQLite database (created automatically by the app)
DATABASE_URL=sqlite:///job_tracker.db
# Optional: used by import_sample_data.py to select the account for sample data
SAMPLE_USER_EMAIL=you@example.com
